# Copy this file to .env and fill in your own values during development.

# Your OpenAI API key. Leave empty to run in mock mode automatically.
OPENAI_API_KEY=

# The OpenAI text model used for interview questions and evaluation.
OPENAI_MODEL=gpt-4o-mini

# When true, the app never calls OpenAI and uses the built-in mock
# interviewer instead. Useful for UI development without spending money.
USE_MOCK_AI=true
